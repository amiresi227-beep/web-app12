{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app12",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "11aed990-00f7-406d-a6cc-0e265ed351df","database_name": "web-app12" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fccc49dffb784135b5fd6f17052d2095" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
